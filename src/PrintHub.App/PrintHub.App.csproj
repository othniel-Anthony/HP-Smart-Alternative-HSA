<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PrintHub.App</RootNamespace>
    <AssemblyName>HSA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\HSA.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrintHub.Core\PrintHub.Core.csproj" />
  </ItemGroup>
  <!-- WinUI looks for "<exe name>.pri". Also publish the same file as resources.pri so the exe still starts when it is renamed
       (browsers rename downloads, people add version numbers, ...). -->
  <Target Name="AddResourcesPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)HSA.pri" RelativePath="resources.pri" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(OutDir)HSA.pri')" />
    </ItemGroup>
  </Target>
  <!-- The self-contained Windows App SDK runtime ships on-device AI / machine-learning / widgets components (onnxruntime, DirectML,
       Microsoft.Windows.AI.*, ...) that HSA never loads: ~46 MB that a single-file build must unpack and virus-scan on every first launch. -->
  <Target Name="TrimUnusedWindowsAppSdkParts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedSdkPart Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(onnxruntime|DirectML|Microsoft\.Windows\.(AI|Workloads|Widgets)\.|workloads\.json)', RegexOptions.IgnoreCase))" />
      <ResolvedFileToPublish Remove="@(_UnusedSdkPart)" />
    </ItemGroup>
    <Message Importance="high" Text="Left out of the publish: @(_UnusedSdkPart->Count()) unused Windows App SDK files" />
  </Target>
  <ItemGroup>
    <Content Include="Assets\HSA.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\HSA.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
