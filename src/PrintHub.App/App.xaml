<Application x:Class="PrintHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- heading colour needs to differ per theme to stay readable -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SectionTitleBrush" Color="#7566B8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SectionTitleBrush" Color="#B5AEDD" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- ============ pastel palette ============
           "Ink" = the colour used for icons, bars and text accents (soft but readable on light and dark).
           Tiles use only the Ink colour, for their icon. -->
      <Color x:Key="PinkInkColor">#D98BA3</Color>
      <Color x:Key="MintInkColor">#6BB596</Color>
      <Color x:Key="LavenderInkColor">#9A8BD6</Color>
      <Color x:Key="PeachInkColor">#E0A07A</Color>
      <Color x:Key="SkyInkColor">#6FA5D4</Color>
      <Color x:Key="ButterInkColor">#CDB052</Color>

      <SolidColorBrush x:Key="PinkInk" Color="{StaticResource PinkInkColor}" />
      <SolidColorBrush x:Key="MintInk" Color="{StaticResource MintInkColor}" />
      <SolidColorBrush x:Key="LavenderInk" Color="{StaticResource LavenderInkColor}" />
      <SolidColorBrush x:Key="PeachInk" Color="{StaticResource PeachInkColor}" />
      <SolidColorBrush x:Key="SkyInk" Color="{StaticResource SkyInkColor}" />
      <SolidColorBrush x:Key="ButterInk" Color="{StaticResource ButterInkColor}" />




      <!-- the line under the printer bar -->
      <SolidColorBrush x:Key="PastelLineBrush" Color="#40BFB1F2" />
      <SolidColorBrush x:Key="PastelCardBorder" Color="#30BFB1F2" />

      <!-- navigation: lavender indicator and a soft wash behind the selected item -->
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#9A8BD6" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#22BFB1F2" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2CBFB1F2" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#36BFB1F2" />

      <!-- ============ styles ============ -->
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PastelCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SectionTitleBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>

      <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Width" Value="170" />
        <Setter Property="Height" Value="130" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
