<Page x:Class="PrintHub.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource CardStyle}">
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE749;" FontSize="56" VerticalAlignment="Center" Foreground="{StaticResource LavenderInk}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" Text="No printer selected" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="StateLine" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="DetailsButton" Content="Printer details" Click="Details_Click" HorizontalAlignment="Stretch" />
            <Button x:Name="FindButton" Content="Search again" Click="Find_Click" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel x:Name="AlertsPanel" Spacing="8" />

      <StackPanel>
        <TextBlock Text="What would you like to do?" Style="{StaticResource SectionTitle}" />
        <GridView x:Name="Tiles" SelectionMode="None" IsItemClickEnabled="False" Margin="-4,0,0,0" />
      </StackPanel>

      <Border x:Name="SuppliesCard" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Ink and toner levels" Style="{StaticResource SectionTitle}" />
          <StackPanel x:Name="SuppliesPanel" />
          <TextBlock x:Name="SuppliesNote" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel Spacing="8">
          <TextBlock Text="No printer yet" Style="{StaticResource SectionTitle}" />
          <TextBlock TextWrapping="Wrap" Text="HSA looks for printers on your network, USB and in Windows. If yours isn't listed, make sure it is switched on and connected to the same network or USB port, then search again, or add it by its IP address." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
