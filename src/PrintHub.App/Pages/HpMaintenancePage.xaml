<Page x:Class="PrintHub.App.Pages.HpMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Text="HP maintenance" />
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <Grid>
            <TextBlock Text="Ink levels" Style="{StaticResource SectionTitle}" />
            <Button x:Name="RefreshButton" HorizontalAlignment="Right" Click="Refresh_Click" Content="Refresh" AutomationProperties.Name="Refresh ink levels" />
          </Grid>
          <StackPanel x:Name="SuppliesPanel" />
          <TextBlock x:Name="SuppliesNote" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Printhead" Style="{StaticResource SectionTitle}" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Cleaning and alignment print a page: load plain paper first." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <DropDownButton x:Name="CleanMenuButton" Content="Clean printhead" AutomationProperties.Name="Clean printhead">
              <DropDownButton.Flyout><MenuFlyout x:Name="CleanMenu" Placement="BottomEdgeAlignedLeft" /></DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="AlignButton" Click="Align_Click" Content="Align printhead" AutomationProperties.Name="Align printhead" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="Reports" Style="{StaticResource SectionTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Print quality and check pages, listed from what this printer offers." />
          </StackPanel>
          <DropDownButton x:Name="ReportMenuButton" Grid.Column="1" VerticalAlignment="Center" Content="Print a report" AutomationProperties.Name="Print a report">
            <DropDownButton.Flyout><MenuFlyout x:Name="ReportMenu" Placement="BottomEdgeAlignedRight" /></DropDownButton.Flyout>
          </DropDownButton>
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <HyperlinkButton x:Name="WebButton" Click="Web_Click" Content="Printer web page" />
        <HyperlinkButton x:Name="DriverButton" Click="Driver_Click" Content="HP driver settings" />
        <HyperlinkButton x:Name="ReportCopyButton" Click="Diagnostics_Click" Content="Copy diagnostics" AutomationProperties.Name="Copy HP diagnostics" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" MaxWidth="700" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
