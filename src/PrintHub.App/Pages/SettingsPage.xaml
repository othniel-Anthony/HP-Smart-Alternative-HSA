<Page x:Class="PrintHub.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
          <ComboBox x:Name="ThemeCombo" Header="Theme" MinWidth="220" SelectionChanged="Theme_Changed" />
          <TextBox x:Name="FolderBox" Header="Save scans in" IsReadOnly="True" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Change folder…" Click="ChangeFolder_Click" />
            <Button Content="Use default" Click="DefaultFolder_Click" />
            <Button Content="Open folder" Click="OpenFolder_Click" />
          </StackPanel>
          <CheckBox x:Name="OpenFolderCheck" Content="Show the file in File Explorer after saving a scan" Click="Options_Click" />
          <CheckBox x:Name="SearchableCheck" Content="Make scanned PDFs searchable by default (text recognition)" Click="Options_Click" />
          <TextBlock x:Name="OcrNote" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Connection and printing" Style="{StaticResource SectionTitle}" />
          <ComboBox x:Name="RouteCombo" Header="Print using" MinWidth="280" SelectionChanged="Route_Changed" />
          <ToggleSwitch x:Name="UsbSwitch" Header="Prefer USB when a printer is connected by both USB and network" Toggled="Usb_Toggled" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Printers added by address" Style="{StaticResource SectionTitle}" />
          <StackPanel x:Name="SavedPanel" Spacing="4" />
          <TextBlock x:Name="SavedNone" Text="None. Printers found automatically don't need to be added." Opacity="0.7" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <Grid>
            <TextBlock Text="USB printer connections" Style="{StaticResource SectionTitle}" />
            <Button HorizontalAlignment="Right" Content="Rescan" Click="RescanUsb_Click" />
          </Grid>
          <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     Text="Printers that expose a web server over USB (HP “web services” and standard IPP-USB) can be used without any network. An interface must be using the WinUSB driver to be opened." />
          <TextBox x:Name="UsbBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="170" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open log folder" Click="OpenLogs_Click" />
            <Button Content="Open settings folder" Click="OpenSettings_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
