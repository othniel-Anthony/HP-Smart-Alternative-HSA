<Page x:Class="PrintHub.App.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
      <Grid>
        <StackPanel>
          <TextBlock Text="Shortcuts" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock Opacity="0.7" Text="One-tap workflows: scan or copy with fixed settings and save, open or print the result." />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="New_Click" AutomationProperties.Name="New shortcut">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New shortcut" /></StackPanel>
        </Button>
      </Grid>
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" Severity="Warning" />
      <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Severity="Success">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <HyperlinkButton Content="Open" Click="OpenResult_Click" />
          <HyperlinkButton Content="Show in folder" Click="ShowResult_Click" />
        </StackPanel>
      </InfoBar>
      <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Opacity="0.8" />
      <GridView x:Name="Cards" SelectionMode="None" IsItemClickEnabled="False" Margin="-4,0,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
