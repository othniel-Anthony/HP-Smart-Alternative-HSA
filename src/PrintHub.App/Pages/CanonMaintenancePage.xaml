<Page x:Class="PrintHub.App.Pages.CanonMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Text="Canon maintenance" />
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Print head" Style="{StaticResource SectionTitle}" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Print a nozzle check first (Reports below). Clean only if lines are missing, and load plain paper first." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <DropDownButton x:Name="CleanMenuButton" Content="Clean print head" AutomationProperties.Name="Clean print head">
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuFlyoutItem Text="Cleaning (all colours)" Tag="Clean" Click="Action_Click" AutomationProperties.Name="Cleaning" />
                  <MenuFlyoutItem Text="Deep cleaning (all colours)" Tag="CleanDeep" Click="Action_Click" AutomationProperties.Name="Deep cleaning" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Black only" Tag="CleanBlack" Click="Action_Click" AutomationProperties.Name="Cleaning black only" />
                  <MenuFlyoutItem Text="Colours only" Tag="CleanColour" Click="Action_Click" AutomationProperties.Name="Cleaning colours only" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Deep cleaning: black only" Tag="CleanBlackDeep" Click="Action_Click" AutomationProperties.Name="Deep cleaning black only" />
                  <MenuFlyoutItem Text="Deep cleaning: colours only" Tag="CleanColourDeep" Click="Action_Click" AutomationProperties.Name="Deep cleaning colours only" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="AlignButton" Tag="AutoAlign" Click="Action_Click" Content="Align print head" AutomationProperties.Name="Align print head" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="Reports" Style="{StaticResource SectionTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Print quality pages: the nozzle check and the head alignment check." />
          </StackPanel>
          <DropDownButton x:Name="ReportMenuButton" Grid.Column="1" VerticalAlignment="Center" Content="Print a report" AutomationProperties.Name="Print a report">
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem Text="Nozzle check pattern" Tag="NozzleCheck" Click="Action_Click" AutomationProperties.Name="Nozzle check pattern" />
                <MenuFlyoutItem Text="Head alignment check page" Tag="AlignmentCheck" Click="Action_Click" AutomationProperties.Name="Head alignment check page" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>
      </Border>

      <Expander x:Name="PadExpander" Header="Ink absorber (waste ink pad) counter" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Ink absorber counter">
        <StackPanel Spacing="8">
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="HSA cannot reset this counter on Canon printers yet. Canon only allows it from a service mode that you enter with a button sequence on the printer, and the commands differ for every model and are not published. The error (for example 5B00) means the ink absorber has reached its limit: have it cleaned or replaced, because resetting alone can let ink leak." />
          <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="If your model has been worked out by someone else in the open, tell the developer which one it is." />
        </StackPanel>
      </Expander>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <HyperlinkButton x:Name="DriverButton" Click="Driver_Click" Content="Canon driver settings" />
        <HyperlinkButton x:Name="QueueButton" Click="Queue_Click" Content="Print queue" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" MaxWidth="700" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
