<Page x:Class="PrintHub.App.Pages.MaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer>
    <StackPanel Padding="32,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Text="Epson maintenance" />
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Print head" Style="{StaticResource SectionTitle}" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Print a nozzle check first. Clean only if lines are missing." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="NozzleButton" Click="Nozzle_Click" AutomationProperties.Name="Print nozzle check">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" FontSize="16" /><TextBlock Text="Print nozzle check" /></StackPanel>
            </Button>
            <DropDownButton x:Name="CleanMenuButton" Content="Clean print head" AutomationProperties.Name="Clean print head">
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuFlyoutItem Text="Level 1: light (one cleaning)" Tag="1" Click="Clean_Click" AutomationProperties.Name="Cleaning level 1" />
                  <MenuFlyoutItem Text="Level 2: medium (two in a row)" Tag="2" Click="Clean_Click" AutomationProperties.Name="Cleaning level 2" />
                  <MenuFlyoutItem Text="Level 3: strong (three in a row)" Tag="3" Click="Clean_Click" AutomationProperties.Name="Cleaning level 3" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Black only" Tag="Black" Click="Clean_Click" AutomationProperties.Name="Black only" />
                  <MenuFlyoutItem Text="Colours only" Tag="Colour" Click="Clean_Click" AutomationProperties.Name="Colours only" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Power ink flush…" Click="PowerFlush_Click" AutomationProperties.Name="Power ink flush" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <CheckBox x:Name="CheckAfter" Content="Print a nozzle check afterwards" IsChecked="True" VerticalAlignment="Center" />
            <Button x:Name="EjectButton" Click="Eject_Click" Content="Push out a stuck sheet" AutomationProperties.Name="Push out a stuck sheet"
                    ToolTipService.ToolTip="Sends the printer the signal that ends a page, so a sheet that stayed inside (for example after a stopped nozzle check) comes out. Nothing else is sent." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="Printer" Style="{StaticResource SectionTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="For a printer that shows offline or ignores jobs: clears the waiting jobs and sends it a reset." />
          </StackPanel>
          <Button x:Name="ResetButton" Grid.Column="1" VerticalAlignment="Center" Click="Reset_Click" AutomationProperties.Name="Reset printer">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="16" /><TextBlock Text="Reset printer" /></StackPanel>
          </Button>
        </Grid>
      </Border>

      <Expander x:Name="CountersExpander" Header="Waste ink counters" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Waste ink counters">
        <StackPanel Spacing="12">
          <TextBlock Opacity="0.7" TextWrapping="Wrap"
                     Text="Clears the “Service required” counters after the waste ink pads have been cleaned or replaced. A reset only clears the counter: if the pads are full, ink can leak." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CheckButton" Click="Check_Click" Content="Check counters" AutomationProperties.Name="Check counters" />
            <Button x:Name="CountersResetButton" Click="CountersReset_Click" Content="Reset counters…" AutomationProperties.Name="Reset counters" />
            <Button x:Name="UndoButton" Click="Undo_Click" Content="Undo last reset" AutomationProperties.Name="Undo last reset" />
          </StackPanel>
          <StackPanel x:Name="CountersPanel" Spacing="6" />
          <TextBlock x:Name="CountersNote" TextWrapping="Wrap" Opacity="0.8" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DbText" TextWrapping="Wrap" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="DbButton" Grid.Column="1" Click="Db_Click" Content="Use a different database file…" AutomationProperties.Name="Choose database file" />
          </Grid>
        </StackPanel>
      </Expander>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <HyperlinkButton x:Name="DriverButton" Click="Driver_Click" Content="Epson driver settings" />
        <HyperlinkButton x:Name="QueueButton" Click="Queue_Click" Content="Print queue" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" />
        <Button x:Name="StopButton" Content="Stop waiting" Click="Stop_Click" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Stop waiting" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" MaxWidth="700" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
