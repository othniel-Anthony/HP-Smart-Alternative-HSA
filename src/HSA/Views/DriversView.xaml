<UserControl x:Class="HSA.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.4*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Driver list ===== -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Drivers" Style="{StaticResource HeadlineMediumText}"/>
                        <CheckBox Content="HP only" IsChecked="{Binding HpOnly}" Margin="20,0,16,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Only in use" IsChecked="{Binding OnlyInUse}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource M3TonalButton}" Content="Refresh"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyMediumText}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,8"/>

                <ListBox Grid.Row="2" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Drivers}"
                         SelectedItem="{Binding SelectedDriver, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" Style="{StaticResource TitleMediumText}"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodySmallText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Actions ===== -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource M3Card}">
            <StackPanel>
                <TextBlock Text="Actions" Style="{StaticResource TitleLargeText}" Margin="0,0,0,12"/>

                <Button Style="{StaticResource M3FilledButtonError}" Content="Remove selected driver"
                        Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                <Button Style="{StaticResource M3FilledButtonError}" Content="Remove ALL HP drivers"
                        Command="{Binding RemoveAllHpCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <Button Style="{StaticResource M3TonalButton}" Content="Install driver from INFâ€¦"
                        Command="{Binding InstallFromInfCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <TextBlock Text="What this does" Style="{StaticResource TitleSmallText}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource BodySmallText}" TextWrapping="Wrap">
                    Removing a driver also removes the INF and binaries from the driver store.
                    The printer will stop working until a driver is reinstalled.
                    <LineBreak/><LineBreak/>
                    "Remove ALL HP drivers" force-removes even when printers still reference a
                    driver. Reinstall afterward via Windows Update or the INF install action.
                    <LineBreak/><LineBreak/>
                    UAC will prompt for each pnputil call.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== Activity log ===== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Activity log" Style="{StaticResource TitleLargeText}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Log}"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
