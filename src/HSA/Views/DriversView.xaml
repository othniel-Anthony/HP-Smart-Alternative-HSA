<UserControl x:Class="HSA.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             xmlns:cv="clr-namespace:HSA.Converters"
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:NullToVisibilityConverter x:Key="NullVis"/>
    </UserControl.Resources>

    <!-- Layout (v0.2.0 - search & download card removed):
         Row 0  = Drivers list  (left, 2*) + Actions  (right, 1.3*) — 2.5* combined
         Row 1  = Activity log  (full-width)
         Star weights: 2.5 / 0.6
         v0.1's search & download card was removed in v0.2.0: the Quick install URL
         field is now a compact one-liner in the Actions card, and the
         "Open HP support" / "Open MS catalog" buttons are still available there
         for users who want to grab a download URL. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.5*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Driver list ===== -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Drivers" Style="{StaticResource HeadlineMediumText}"/>
                        <CheckBox Content="HP only" IsChecked="{Binding HpOnly}" Margin="20,0,16,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Only in use" IsChecked="{Binding OnlyInUse}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource M3TonalButton}" Content="Refresh"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyMediumText}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                <Grid Grid.Row="2" Margin="0,0,0,8"
                      Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}">
                    <ProgressBar Style="{StaticResource M3ProgressBar}"
                                 Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding InstallIsIndeterminate, Mode=OneWay}"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </Grid>

                <ListBox Grid.Row="3" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Drivers}"
                         SelectedItem="{Binding SelectedDriver, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" Style="{StaticResource TitleMediumText}"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodySmallText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Actions (Install first, then Removal, then Quick install URL) ===== -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource M3Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource TitleLargeText}" Margin="0,0,0,12"/>

                    <!-- Install (positive action first, always visible) -->
                    <Button Style="{StaticResource M3FilledButton}" Content="Install driver from INF…"
                            Command="{Binding InstallFromInfCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource M3TonalButton}" Content="Reinstall selected driver"
                            Command="{Binding ReinstallSelectedCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                            ToolTip="Re-adds the selected driver's INF to the store (pnputil /add-driver /install)"/>

                    <!-- Removal (destructive). v0.2.6: prefer the ALL button — one
                         UAC for every HP driver, instead of one UAC per click
                         on the per-driver row. -->
                    <TextBlock Text="Removal" Style="{StaticResource TitleSmallText}"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,8"/>
                    <Button Style="{StaticResource M3FilledButtonError}" Content="Remove ALL HP drivers  (1 UAC)"
                            Command="{Binding RemoveAllHpCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                            ToolTip="Removes every HP driver package in one elevated cmd.exe run — you only see one UAC prompt."/>
                    <Button Style="{StaticResource M3OutlinedButton}" Content="Remove only the selected driver"
                            Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                            ToolTip="Removes just the highlighted driver. Still triggers its own UAC prompt — use the ALL button above for batch removal."/>

                    <!-- Full registry cleanup toggle -->
                    <Border Style="{StaticResource M3CardFilled}" Padding="12,10" Margin="0,0,0,12"
                            CornerRadius="12">
                        <StackPanel>
                            <CheckBox Content="Full registry cleanup" IsChecked="{Binding FullRegistryCleanup, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource BodySmallText}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0">
                                Also unregisters the PnP devices bound to this driver and clears
                                their HKLM\…\Services\&lt;svc&gt; / Enum\&lt;inst&gt; entries. All commands
                                run in one elevated cmd.exe - one UAC prompt for the whole batch.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Quick install from URL — paste a direct download link and one
                         click downloads + extracts INFs + runs pnputil /add-driver.
                         Browser shortcuts below open the standard driver search pages
                         in the user's default browser so the URL is easy to grab. -->
                    <TextBlock Text="Quick install from URL" Style="{StaticResource TitleSmallText}"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding QuickInstallUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12"
                                 ToolTip="Direct download URL. Click 'Download &amp; install' to download, extract, and pnputil-install in one shot."/>
                        <Button Grid.Column="1" Style="{StaticResource M3FilledButton}" Content="Install"
                                Command="{Binding QuickInstallCommand}" Margin="6,0,0,0" Padding="14,6"
                                ToolTip="Downloads to %LOCALAPPDATA%\HSA\Downloads, extracts INFs, runs pnputil /add-driver."/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource M3OutlinedButton}" Content="HP support"
                                Command="{Binding OpenHpSupportCommand}" Margin="0,0,3,0" Padding="6,4" FontSize="11"/>
                        <Button Grid.Column="1" Style="{StaticResource M3OutlinedButton}" Content="MS catalog"
                                Command="{Binding OpenMicrosoftUpdateCatalogCommand}" Margin="3,0,0,0" Padding="6,4" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Activity log (now full-width, bigger) ===== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Activity log" Style="{StaticResource TitleLargeText}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Log}"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
