<UserControl x:Class="HSA.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             xmlns:m="clr-namespace:HSA.Models"
             xmlns:cv="clr-namespace:HSA.Converters"
             d:DataContext="{d:DesignInstance Type=vm:PrintersViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <cv:ColorNameToBrushConverter x:Key="ColorToBrush"/>
        <cv:CountToVisibilityConverter x:Key="CountVis"/>

        <!-- One consumable chip: small rounded badge, ink/toner colored, white text.
             The Background is bound to a converter that maps ConsumableStatus.Color
             to a SolidColorBrush, so the chip stays the same in light and dark themes. -->
        <DataTemplate x:Key="ConsumableChipTemplate" DataType="{x:Type m:ConsumableStatus}">
            <Border CornerRadius="10" Padding="8,3" Margin="0,0,6,0"
                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                    VerticalAlignment="Center">
                <TextBlock Foreground="White" FontSize="11" FontWeight="Medium"
                           Text="{Binding LevelDisplay}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT: printers list card ===== -->
        <Border Grid.Column="0" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Printers" Style="{StaticResource HeadlineMediumText}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="HP only" IsChecked="{Binding ShowOnlyHp}" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Discover network"
                                Command="{Binding DiscoverNetworkPrintersCommand}" Margin="0,0,8,0"
                                ToolTip="Browse the local network for IPP-advertising printers (mDNS)"/>
                        <Button Style="{StaticResource M3TonalButton}" Content="Refresh"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Subheader / status -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyMediumText}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,8"/>

                <!-- List -->
                <ListBox Grid.Row="2" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Printers}"
                         SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Row 0: existing horizontal layout (image + info + status) -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Model image -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                                            ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,48,48"/>
                                        </Border.Clip>
                                        <Image Source="{Binding ModelImageUri}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TitleMediumText}"/>
                                        <TextBlock Text="{Binding ModelFamily}" Style="{StaticResource BodySmallText}"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Style="{StaticResource BodySmallText}" Margin="0,2,0,0">
                                            <Run Text="{Binding PortName}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding DriverName}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource M3StatusPill}">
                                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource LabelMediumText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Connection}" Style="{StaticResource BodySmallText}"
                                                   HorizontalAlignment="Right" Margin="0,4,2,0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Row 1: consumable chips (hidden when Consumables is empty) -->
                                <ItemsControl Grid.Row="1" Margin="62,6,0,0"
                                              ItemsSource="{Binding Consumables}"
                                              ItemTemplate="{StaticResource ConsumableChipTemplate}"
                                              HorizontalAlignment="Stretch"
                                              Visibility="{Binding Consumables.Count, Converter={StaticResource CountVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== RIGHT: actions + jobs ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Actions card. Fixed max height + ScrollViewer so the EWS / Remove
                 buttons at the bottom are always reachable even on short windows. -->
            <Border Grid.Row="0" Style="{StaticResource M3Card}" MaxHeight="540" VerticalAlignment="Top"
                    HorizontalAlignment="Stretch" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource TitleLargeText}" Margin="0,0,0,12"/>

                        <!-- Single-column button list. v0.2.1's 2-column grid was
                             overflowing the right column on some window widths,
                             so we trade density for guaranteed reachability. -->
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Set as default"
                                Command="{Binding SetAsDefaultCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Test page"
                                Command="{Binding PrintTestPageCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Printing preferences"
                                Command="{Binding OpenPrintingPreferencesCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Advanced properties"
                                Command="{Binding OpenAdvancedPropertiesCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Pause queue"
                                Command="{Binding PauseQueueCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Resume queue"
                                Command="{Binding ResumeQueueCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Detect firmware"
                                Command="{Binding DetectFirmwareCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                        <Button Style="{StaticResource M3TonalButton}" Content="Install driver INF…"
                                Command="{Binding InstallDriverCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,8"/>

                        <Button Style="{StaticResource M3TextButton}" Content="Purge print queue"
                                Command="{Binding PurgeQueueCommand}" HorizontalAlignment="Left"/>

                        <Separator Margin="0,8" Background="{StaticResource OutlineVariantBrush}"/>

                        <!-- EWS (Embedded Web Server): set the URL once and the user can
                             open the printer's EWS dashboard in their browser. Also lets
                             HSA read consumables (ink/toner state, model, firmware) for
                             WSD-USB printers that don't expose a reachable IPP endpoint. -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="EWS" Style="{StaticResource TitleSmallText}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource M3StatusPill}"
                                    Background="{Binding EwsStatusBrush}"
                                    ToolTip="{Binding EwsStatusText}">
                                <TextBlock Text="{Binding EwsStatusShortText}" Style="{StaticResource LabelMediumText}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding EwsUrlDisplay}"
                                   Style="{StaticResource BodySmallText}"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                   ToolTip="{Binding EwsUrlDisplay}"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Open printer EWS…"
                                Command="{Binding OpenEwsCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                ToolTip="Opens the printer's Embedded Web Server in your default browser. Lets you change Wi-Fi, update firmware, see ink levels, etc."/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Discover EWS"
                                Command="{Binding DiscoverEwsCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                ToolTip="Auto-discover the printer's EWS URL by probing the IP, mDNS, and the WSD Port Monitor registry. Saves the result for future launches."/>
                        <Button Style="{StaticResource M3TextButton}" Content="Set EWS URL…"
                                Command="{Binding ConfigureEwsCommand}" HorizontalAlignment="Left"/>

                        <Separator Margin="0,8" Background="{StaticResource OutlineVariantBrush}"/>

                        <Button Style="{StaticResource M3FilledButtonError}" Content="Remove printer"
                                Command="{Binding DeletePrinterCommand}" HorizontalAlignment="Stretch"
                                ToolTip="Removes this printer from the Windows spooler. The driver stays installed."/>
                        <Button Style="{StaticResource M3TextButton}" Content="Open in Windows Settings…"
                                Command="{Binding OpenWindowsPrintersSettingsCommand}" HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTip="Opens Windows Settings → Bluetooth &amp; devices → Printers &amp; scanners, where you can remove a printer with a standard UAC prompt."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Jobs card -->
            <Border Grid.Row="2" Style="{StaticResource M3Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Print jobs" Style="{StaticResource TitleLargeText}"/>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource M3ListBox}"
                             ItemContainerStyle="{StaticResource M3ListItem}"
                             ItemsSource="{Binding Jobs}"
                             SelectedItem="{Binding SelectedJob, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource TitleSmallText}"/>
                                        <TextBlock Style="{StaticResource BodySmallText}" Margin="0,2,0,0">
                                            <Run Text="{Binding PagesPrinted}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalPages}"/>
                                            <Run Text=" pages"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                                               Style="{StaticResource LabelMediumText}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
