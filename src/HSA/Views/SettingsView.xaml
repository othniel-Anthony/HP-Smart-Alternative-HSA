<UserControl x:Class="HSA.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingRowBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT: Preferences (settings) ===== -->
        <Border Grid.Column="0" Style="{StaticResource M3Card}">
            <StackPanel>
                <TextBlock Text="Preferences" Style="{StaticResource HeadlineMediumText}" Margin="0,0,0,16"/>

                <!-- Dark mode row -->
                <Border Style="{StaticResource SettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Dark mode" Style="{StaticResource TitleMediumText}"/>
                            <TextBlock Text="Use the Material You dark color scheme. Affects the entire app."
                                       Style="{StaticResource BodySmallText}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,16,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource M3Switch}"
                                  IsChecked="{Binding IsDarkMode, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Start with HP only row -->
                <Border Style="{StaticResource SettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Start with HP-only filter" Style="{StaticResource TitleMediumText}"/>
                            <TextBlock Text="When the app opens, hide non-HP printers in the list."
                                       Style="{StaticResource BodySmallText}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,16,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource M3Switch}"
                                  IsChecked="{Binding StartWithHpOnlyFilter, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Settings are saved automatically to %LOCALAPPDATA%\HSA\settings.json."
                           Style="{StaticResource BodySmallText}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== RIGHT: About + paths ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- About card -->
            <Border Grid.Row="0" Style="{StaticResource M3Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="16"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Margin="0,0,16,0">
                            <Border.Clip>
                                <RectangleGeometry RadiusX="16" RadiusY="16" Rect="0,0,56,56"/>
                            </Border.Clip>
                            <Image Source="/Resources/icon-mark.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" Style="{StaticResource TitleLargeText}"/>
                            <TextBlock Style="{StaticResource BodyMediumText}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}">
                                <Run Text="v"/>
                                <Run Text="{Binding VersionDisplay, Mode=OneWay}"/>
                                <Run Text="  •  "/>
                                <Run Text="{Binding TargetFramework, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource BodyMediumText}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodySmallText}"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource BodySmallText}" Margin="0,0,0,2">
                        <Run Text="Publisher:"/>
                        <Run Text="{Binding Publisher, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodySmallText}" Margin="0,0,0,2">
                        <Run Text="Build:"/>
                        <Run Text="{Binding BuildDate, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodySmallText}" Margin="0,0,0,12">
                        <Run Text="Repository:"/>
                        <Run Text="{Binding RepoUrl, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Open data folder"
                                Command="{Binding OpenDataFolderCommand}" Margin="0,0,4,4"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Open repository"
                                Command="{Binding OpenRepoCommand}" Margin="4,0,0,4"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="View releases"
                                Command="{Binding OpenReleasesCommand}" Margin="0,0,4,4"/>
                        <Button Style="{StaticResource M3OutlinedButton}" Content="Copy version"
                                Command="{Binding CopyVersionCommand}" Margin="4,0,0,4"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Paths card -->
            <Border Grid.Row="2" Style="{StaticResource M3Card}">
                <StackPanel>
                    <TextBlock Text="Local data" Style="{StaticResource TitleLargeText}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Settings file"
                                   Style="{StaticResource BodyMediumText}"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SettingsFilePath, Mode=OneWay}"
                                   Style="{StaticResource BodyMediumText}"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Logs"
                                   Style="{StaticResource BodyMediumText}"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LogsPath, Mode=OneWay}"
                                   Style="{StaticResource BodyMediumText}"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App data"
                                   Style="{StaticResource BodyMediumText}"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DataPath, Mode=OneWay}"
                                   Style="{StaticResource BodyMediumText}"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
