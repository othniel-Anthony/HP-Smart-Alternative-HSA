<UserControl x:Class="HSA.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FirmwareViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- ===== HP printers ===== -->
        <Border Grid.Column="0" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="HP printers" Style="{StaticResource HeadlineMediumText}"/>
                    <Button Grid.Column="1" Style="{StaticResource M3TonalButton}" Content="Refresh"
                            Command="{Binding LoadPrintersCommand}"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource M3FilledButton}" Content="Detect selected"
                            Command="{Binding DetectSelectedCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource M3TonalButton}" Content="Detect all HP"
                            Command="{Binding DetectAllHpCommand}"/>
                </StackPanel>

                <ListBox Grid.Row="2" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Printers}"
                         SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource TitleMediumText}"/>
                                <TextBlock Text="{Binding PortName}" Style="{StaticResource BodySmallText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Results ===== -->
        <Border Grid.Column="2" Style="{StaticResource M3Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Firmware results" Style="{StaticResource HeadlineMediumText}" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource M3FilledButton}" Content="Open HP support page"
                            Command="{Binding OpenHpSupportCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource M3TonalButton}" Content="Push firmware from URL…"
                            Command="{Binding PushFirmwareCommand}"
                            ToolTip="PWG 5100.11 IPP System Services Update-Operation. The printer downloads the firmware from the URL and applies it."/>
                </StackPanel>

                <ListBox Grid.Row="2" Style="{StaticResource M3ListBox}"
                         ItemContainerStyle="{StaticResource M3ListItem}"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding PrinterName}" Style="{StaticResource TitleMediumText}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model:" Style="{StaticResource BodySmallText}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ModelIdentifier, TargetNullValue='(unknown)'}" Style="{StaticResource BodySmallText}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Firmware:" Style="{StaticResource BodySmallText}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVersionDisplay}" Style="{StaticResource BodyMediumText}" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource BodySmallText}">
                                    <Run Text="Detection:"/>
                                    <Run Text="{Binding DetectionMethodDisplay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodySmallText}">
                                    <Run Text="Update path:"/>
                                    <Run Text="{Binding UpdateCapabilityDisplay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
