<UserControl x:Class="HSA.Views.SuppliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HSA.ViewModels"
             xmlns:m="clr-namespace:HSA.Models"
             xmlns:cv="clr-namespace:HSA.Converters"
             d:DataContext="{d:DesignInstance Type=vm:SuppliesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <cv:IntEqualsConverter x:Key="IntEq" />
        <cv:CountToVisibilityConverter x:Key="CountVis" />
        <cv:PercentToWidthConverter x:Key="PctToWidth" />

        <!-- Color-coded consumable status pill (M3 chip pattern) -->
        <Style x:Key="HealthPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.Ok}">
                    <Setter Property="Background" Value="#D6F4DD"/>
                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.Low}">
                    <Setter Property="Background" Value="#FFF3D6"/>
                    <Setter Property="BorderBrush" Value="#EF6C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.ReplaceSoon}">
                    <Setter Property="Background" Value="#FFE2C7"/>
                    <Setter Property="BorderBrush" Value="#D84315"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.ReplaceNow}">
                    <Setter Property="Background" Value="#FFDAD6"/>
                    <Setter Property="BorderBrush" Value="#BA1A1A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.Empty}">
                    <Setter Property="Background" Value="#FFDAD6"/>
                    <Setter Property="BorderBrush" Value="#BA1A1A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static m:ConsumableHealth.Unknown}">
                    <Setter Property="Background" Value="#ECEAEE"/>
                    <Setter Property="BorderBrush" Value="#757680"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource M3Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ink &amp; Toner" Style="{StaticResource HeadlineMediumText}"/>
                <Button Grid.Column="1" Style="{StaticResource M3TonalButton}" Content="Refresh"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Filter chips -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ToggleButton Content="All"           Margin="0,0,8,0" Padding="14,6"
                              IsChecked="{Binding FilterIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                <ToggleButton Content="Low or below"  Margin="0,0,8,0" Padding="14,6"
                              IsChecked="{Binding FilterIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"/>
                <ToggleButton Content="Replace"       Margin="0,0,8,0" Padding="14,6"
                              IsChecked="{Binding FilterIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"/>
            </StackPanel>

            <!-- Status + progress -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource BodyMediumText}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                           Style="{StaticResource LabelLargeText}"
                           Foreground="{StaticResource PrimaryBrush}"
                           Visibility="{Binding ProgressTotal, Converter={StaticResource CountVis}}"/>
            </Grid>

            <!-- List -->
            <ListBox Grid.Row="3" Style="{StaticResource M3ListBox}"
                     ItemContainerStyle="{StaticResource M3ListItem}"
                     ItemsSource="{Binding FilteredItems}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PrinterName}" Style="{StaticResource TitleSmallText}"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource TitleMediumText}"/>
                                <TextBlock Style="{StaticResource BodySmallText}" Margin="0,2,0,0">
                                    <Run Text="Part:" />
                                    <Run Text="{Binding PartNumber, TargetNullValue='—'}" FontWeight="SemiBold"/>
                                    <Run Text="  •  Color:" />
                                    <Run Text="{Binding Color}" FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- Level bar -->
                                <Grid Margin="0,8,0,0" MaxWidth="320" HorizontalAlignment="Left">
                                    <Border Height="8" CornerRadius="4"
                                            Background="{StaticResource SurfaceContainerHighBrush}"/>
                                    <Border Height="8" CornerRadius="4"
                                            Background="{StaticResource PrimaryBrush}"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PctToWidth}">
                                                <Binding Path="LevelPercent"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource HealthPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LevelDisplay}" Style="{StaticResource LabelLargeText}"/>
                                    <TextBlock Text="  •  " Style="{StaticResource LabelLargeText}"/>
                                    <TextBlock Text="{Binding HealthDisplay}" Style="{StaticResource LabelLargeText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
