<Window x:Class="HSA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HSA.Views"
        Title="HSA"
        Icon="Resources/icon.ico"
        Height="820" Width="1240"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource OnBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top app bar (M3 "small") -->
            <RowDefinition Height="64" />
            <!-- Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top app bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand: logo mark + name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="40" Height="40" CornerRadius="12"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,40,40"/>
                        </Border.Clip>
                        <Image Source="Resources/icon-mark.png"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HSA" Style="{StaticResource TitleLargeText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Subtitle / status hint in the center -->
                <TextBlock Grid.Column="1" Margin="24,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Text="Manage HP printers, drivers &amp; firmware — without HP Smart"
                           Style="{StaticResource BodyMediumText}" Foreground="{StaticResource OnSurfaceVariantBrush}"/>

                <!-- Trailing actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource M3TextButton}" Content="About" Click="OnAboutClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="1" Background="{StaticResource BackgroundBrush}">
            <TabControl Margin="20,12,20,20" Background="Transparent">
                <TabItem Header="Printers">
                    <views:PrintersView />
                </TabItem>
                <TabItem Header="Drivers">
                    <views:DriversView />
                </TabItem>
                <TabItem Header="Firmware">
                    <views:FirmwareView />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
